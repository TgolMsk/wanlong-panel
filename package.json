{
  "name": "wanlong-panel",
  "version": "0.1.0",
  "private": true,
  "description": "MuMu 多实例控制面板 —— 截图 + 模板匹配的多账号自动化地基",
  "author": "wanlongjs",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/approve.mjs",
    "approve": "node scripts/approve.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke:build": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/smoke/smoke.mjs --log-level=warning",
    "smoke": "npm run smoke:build && node out/smoke/smoke.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "tplkit:build": "esbuild scripts/tplkit.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/tplkit/tplkit.mjs --log-level=warning",
    "tplkit": "npm run tplkit:build && node out/tplkit/tplkit.mjs",
    "icons": "node scripts/resource-icons.mjs",
    "icons:app": "node scripts/app-icons.mjs",
    "live:sample:build": "esbuild scripts/sched-live-sample.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/live/sched-live-sample.mjs --log-level=warning",
    "live:sample": "npm run live:sample:build && node out/live/sched-live-sample.mjs",
    "check:build": "esbuild scripts/sched-offline-check.ts scripts/gather-offline-verify.ts scripts/gather-offline-scan.ts scripts/gather-offline-dryrun.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outdir=out/check --out-extension:.js=.mjs --log-level=warning",
    "check:sched": "npm run check:build && node out/check/sched-offline-check.mjs",
    "check:gather": "npm run check:build && node out/check/gather-offline-verify.mjs && node out/check/gather-offline-scan.mjs && node out/check/gather-offline-dryrun.mjs",
    "check:alerts:build": "esbuild scripts/alerts-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --alias:electron=./scripts/stubs/electron-offline.mjs --outfile=out/check/alerts-offline-check.mjs --log-level=warning",
    "check:alerts": "npm run check:alerts:build && node out/check/alerts-offline-check.mjs",
    "check:bot:build": "esbuild scripts/bot-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --alias:electron=./scripts/stubs/electron-offline.mjs --outfile=out/check/bot-offline-check.mjs --log-level=warning",
    "check:bot": "npm run check:bot:build && node out/check/bot-offline-check.mjs",
    "check:stats:build": "esbuild scripts/stats-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --alias:electron=./scripts/stubs/electron-offline.mjs --outfile=out/check/stats-offline-check.mjs --log-level=warning",
    "check:stats": "npm run check:stats:build && node out/check/stats-offline-check.mjs",
    "check:resources:build": "esbuild scripts/resources-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --alias:electron=./scripts/stubs/electron-offline.mjs --outfile=out/check/resources-offline-check.mjs --log-level=warning",
    "check:resources": "npm run check:resources:build && node out/check/resources-offline-check.mjs",
    "check:ld:build": "esbuild scripts/ldplayer-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/check/ldplayer-offline-check.mjs --log-level=warning",
    "check:ld": "npm run check:ld:build && node out/check/ldplayer-offline-check.mjs",
    "check:mumu:build": "esbuild scripts/mumu-win-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/check/mumu-win-offline-check.mjs --log-level=warning",
    "check:mumu": "npm run check:mumu:build && node out/check/mumu-win-offline-check.mjs",
    "check:launch:build": "esbuild scripts/gamelaunch-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/check/gamelaunch-offline-check.mjs --log-level=warning",
    "check:launch": "npm run check:launch:build && node out/check/gamelaunch-offline-check.mjs",
    "check:ai:build": "esbuild scripts/ai-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --alias:electron=./scripts/stubs/electron-offline.mjs --outfile=out/check/ai-offline-check.mjs --log-level=warning",
    "check:ai": "npm run check:ai:build && node out/check/ai-offline-check.mjs",
    "check:runtime:build": "esbuild scripts/reliability-offline-check.ts scripts/vision-offline-check.ts scripts/data-offline-check.ts scripts/instances-offline-check.ts scripts/login-offline-check.ts --bundle --platform=node --format=esm --target=node22 --packages=external --define:__dirname=import.meta.dirname --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --alias:electron=./scripts/stubs/electron-runtime-check.mjs --outdir=out/check --out-extension:.js=.mjs --log-level=warning",
    "check:runtime": "npm run check:runtime:build && node out/check/reliability-offline-check.mjs && node out/check/vision-offline-check.mjs && node out/check/data-offline-check.mjs && node out/check/instances-offline-check.mjs && node out/check/login-offline-check.mjs",
    "check": "npm run check:runtime && npm run check:ld && npm run check:mumu && npm run check:launch && npm run check:ai && npm run check:sched && npm run check:gather && npm run check:alerts && npm run check:bot && npm run check:stats && npm run check:resources",
    "live:build": "esbuild scripts/gather-live.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@shared=./src/shared --alias:@main=./src/main --alias:@vision=./src/vision --alias:@worker=./src/worker --outfile=out/live/gather-live.mjs --log-level=warning",
    "live:probe": "npm run live:build && node out/live/gather-live.mjs probe",
    "live:panel": "npm run live:build && node out/live/gather-live.mjs panel",
    "live:run": "npm run live:build && node out/live/gather-live.mjs run",
    "live:recheck": "npm run live:build && node out/live/gather-live.mjs recheck"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "antd": "^6.6.3",
    "konva": "^10.5.0",
    "p-queue": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.7",
    "react-virtuoso": "^4.18.13",
    "sharp": "^0.35.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
