{
  "name": "wanlong-panel",
  "version": "0.1.0",
  "private": true,
  "description": "MuMu 多实例控制面板 —— 截图 + 模板匹配的多账号自动化地基",
  "author": "wanlongjs",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run approve",
    "approve": "npm install-scripts approve electron && npm install-scripts approve esbuild && npm install-scripts approve sharp",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "antd": "^6.6.3",
    "konva": "^10.5.0",
    "p-queue": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.7",
    "react-virtuoso": "^4.18.13",
    "sharp": "^0.35.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
